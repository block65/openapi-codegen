// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a temporal schema names its alias, inlines a property's literal, and defers to a type hint > valibot.ts 1`] = `
"import * as v from "valibot";
import type { Timestamp } from "./types.js";

export const inputTimestampSchema = v.pipe(v.string(), v.custom<Timestamp>((input) => typeof input === "string" && /^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt ]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$/u.test(input), "date-time"));
export const timestampSchema = v.pipe(v.string(), v.trim(), v.custom<Timestamp>((input) => typeof input === "string" && /^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt ]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$/u.test(input), "date-time"));
export const inputWindowSchema = v.strictObject(
    {
        "opensAt": v.pipe(v.string(), v.custom<\`\${number}-\${number}-\${number}\${"T" | "t" | " "}\${number}:\${number}:\${number}\${string}\`>((input) => typeof input === "string" && /^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt ]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$/u.test(input), "date-time"))
        ,
        "closesAt": v.optional(v.pipe(v.string(), v.regex(/^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt ]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$/u, "date-time"), v.custom<Timestamp>(() => true)))
        ,
    });
export const windowSchema = v.strictObject(
    {
        "opensAt": v.pipe(v.string(), v.trim(), v.custom<\`\${number}-\${number}-\${number}\${"T" | "t" | " "}\${number}:\${number}:\${number}\${string}\`>((input) => typeof input === "string" && /^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt ]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$/u.test(input), "date-time"))
        ,
        "closesAt": v.exactOptional(v.pipe(v.string(), v.trim(), v.regex(/^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])[Tt ]([01]\\d|2[0-3]):[0-5]\\d:([0-5]\\d|60)(\\.\\d+)?([Zz]|[+-]([01]\\d|2[0-3]):[0-5]\\d)$/u, "date-time"), v.custom<Timestamp>(() => true)))
        ,
    });
"
`;
