{
	"extends": ["@block65/tsconfig/nodejs26", "@block65/tsconfig/noprojref"],

	"compilerOptions": {
		"types": ["node"],

		// the generator reads the OpenAPI documents it is pointed at
		"resolveJsonModule": true
	},

	"include": [
		"bin",
		"lib",
		"__tests__",
		"oxfmt.config.ts",
		"oxlint.config.ts",
		"vitest.config.ts"
	],

	// generator output compared byte for byte, without its imports' modules
	"exclude": ["__tests__/__snapshots__"]
}
